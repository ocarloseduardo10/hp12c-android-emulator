<?xml version="1.0" encoding="utf-8"?>
<!--
  HP 12C Mobile — Emulador Financeiro para Android
  AndroidManifest: orientação preferencial horizontal (sensorLandscape),
  suporte também a portrait. configChanges evita recriar a Activity ao girar,
  mantendo o estado do motor financeiro intacto.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.hp12c.android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.HP12CMobile"
        tools:targetApi="34">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:theme="@style/Theme.HP12CMobile">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
