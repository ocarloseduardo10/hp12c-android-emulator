<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout principal — fiel ao layout físico da HP 12C.
  4 linhas × 10 colunas, com ENTER como tecla alta (span 2 linhas).

  LINHA 1: n    i    PV   PMT  FV   CHS  7  8  9  ÷
  LINHA 2: yˣ   1/x  %T   Δ%   %    EEX  4  5  6  ×
  LINHA 3: R/S  SST  R↓   x↔y  CLx  ENT  1  2  3  −
  LINHA 4: ON   f    g    STO  RCL  [ENT] 0  .  Σ+ +

  A tecla ENTER é vertical, ocupando posição 6 nas linhas 3 e 4.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/hp_background"
    android:padding="6dp">

    <!-- Corpo da calculadora -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@color/hp_body_dark"
        android:padding="6dp">

        <!-- Display LCD -->
        <com.hp12c.android.ui.LcdDisplayView
            android:id="@+id/lcd_display"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginBottom="6dp" />

        <!-- Teclado 4×10 com ENTER como tecla alta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- LINHA 1: n, i, PV, PMT, FV, CHS, 7, 8, 9, ÷ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <com.hp12c.android.ui.CalculatorKeyView android:id="@+id/key_n"   app:key_code="11" app:key_main="n"   app:key_top="AMORT" app:key_bottom="12×" app:key_color="BEIGE" style="@style/HPKey" />
                <com.hp12c.android.ui.CalculatorKeyView android:id="@+id/key_i"   app:key_code="12" app:key_main="i"   app:key_top="INT"   app:key_bottom="12÷" app:key_color="BEIGE" style="@style/HPKey" />
                <com.hp12c.android.ui.CalculatorKeyView android:id="@+id/key_pv"  app:key_code="13" app:key_main="PV"  app:key_top="NPV"   app:key_bottom="CFo" app:key_color="BEIGE" style="@style/HPKey" />
                <com.hp12c.android.ui.CalculatorKeyView android:id="@+id/key_pmt" app:key_code="14" app:key_main="PMT" app:key_top="RND"   app:key_bottom="CFj" app:key_color="BEIGE" style="@style/HPKey" />
                <com.hp12c.android.ui.CalculatorKeyView android:id="@+id/key_fv"  app:key_code="15" app:key_main="FV"  app:key_top="IRR"   app:key_bottom="Nj"  app:key_color="BEIGE" style="@style/HPKey" />
                <com.hp12c.android.ui.CalculatorKeyView android:id="@+id/key_chs" app:key_code="16" app:key_main="CHS" app:key_top=""      app:key_bottom="DATE" app:key_color="BEIGE" style="@style/HPKey" />
                <com.hp12c.android.ui.CalculatorKeyView android:id="@+id/key_7"   app:key_code="7"  app:key_main="7"   app:key_bottom="BEG" app:key_color="BEIGE" style="@style/HPKey" />
                <com.hp12c.android.ui.CalculatorKeyView android:id="@+id/key_8"   app:key_code="8"  app:key_main="8"   app:key_bottom="END" app:key_color="BEIGE" style="@style/HPKey" />
                <com.hp12c.android.ui.CalculatorKeyView android:id="@+id/key_9"   app:key_code="9"  app:key_main="9"   app:key_bottom="MEM" app:key_color="BEIGE" style="@style/HPKey" />
                <com.hp12c.android.ui.CalculatorKeyView android:id="@+id/key_div" app:key_code="10" app:key_main="÷"   app:key_color="BEIGE" style="@style/HPKey" />
            </LinearLayout>

            <!-- LINHA 2: yˣ, 1/x, %T, Δ%, %, EEX, 4, 5, 6, × -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <com.hp12c.android.ui.CalculatorKeyView android:id="@+id/key_pow"  app:key_code="21" app:key_main="yˣ"  app:key_top="PRICE" app:key_bottom="√"  app:key_color="BEIGE" style="@style/HPKey" />
                <com.hp12c.android.ui.CalculatorKeyView android:id="@+id/key_inv"  app:key_code="22" app:key_main="1/x" app:key_top="YTM"   app:key_bottom="eˣ" app:key_color="BEIGE" style="@style/HPKey" />
                <com.hp12c.android.ui.CalculatorKeyView android:id="@+id/key_pctt" app:key_code="23" app:key_main="%T"  app:key_top="SL"   app:key_bottom="ln"  app:key_color="BEIGE" style="@style/HPKey" />
                <com.hp12c.android.ui.CalculatorKeyView android:id="@+id/key_delp" app:key_code="24" app:key_main="Δ%"  app:key_top="SOYD" app:key_bottom="FRAC" app:key_color="BEIGE" style="@style/HPKey" />
                <com.hp12c.android.ui.CalculatorKeyView android:id="@+id/key_pct"  app:key_code="25" app:key_main="%"   app:key_top="DB"   app:key_bottom="INTG" app:key_color="BEIGE" style="@style/HPKey" />
                <com.hp12c.android.ui.CalculatorKeyView android:id="@+id/key_eex"  app:key_code="26" app:key_main="EEX" app:key_bottom="ΔDYS" app:key_color="BEIGE" style="@style/HPKey" />
                <com.hp12c.android.ui.CalculatorKeyView android:id="@+id/key_4"   app:key_code="4"  app:key_main="4"   app:key_bottom="D.MY" app:key_color="BEIGE" style="@style/HPKey" />
                <com.hp12c.android.ui.CalculatorKeyView android:id="@+id/key_5"   app:key_code="5"  app:key_main="5"   app:key_bottom="M.DY" app:key_color="BEIGE" style="@style/HPKey" />
                <com.hp12c.android.ui.CalculatorKeyView android:id="@+id/key_6"   app:key_code="6"  app:key_main="6"   app:key_bottom="x̄w" app:key_color="BEIGE" style="@style/HPKey" />
                <com.hp12c.android.ui.CalculatorKeyView android:id="@+id/key_mul" app:key_code="20" app:key_main="×"   app:key_color="BEIGE" style="@style/HPKey" />
            </LinearLayout>

            <!-- Container para LINHAS 3 e 4 com ENTER span 2 linhas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2"
                android:orientation="horizontal">

                <!-- Lado esquerdo: colunas 1-5 das linhas 3 e 4 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="5"
                    android:orientation="vertical"
                    android:layout_marginEnd="1dp">

                    <!-- LINHA 3 (cols 1-5): R/S, SST, R↓, x↔y, CLx -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">
                        <com.hp12c.android.ui.CalculatorKeyView android:id="@+id/key_rs"   app:key_code="31" app:key_main="R/S" app:key_top="P/R"  app:key_bottom="PSE" app:key_color="BEIGE" style="@style/HPKey" />
                        <com.hp12c.android.ui.CalculatorKeyView android:id="@+id/key_sst"  app:key_code="32" app:key_main="SST" app:key_top="Σ"   app:key_bottom="BST" app:key_color="BEIGE" style="@style/HPKey" />
                        <com.hp12c.android.ui.CalculatorKeyView android:id="@+id/key_rdown" app:key_code="33" app:key_main="R↓"  app:key_top="PRGM" app:key_bottom="GTO" app:key_color="BEIGE" style="@style/HPKey" />
                        <com.hp12c.android.ui.CalculatorKeyView android:id="@+id/key_swap"  app:key_code="34" app:key_main="x↔y" app:key_top="FIN"   app:key_bottom="x≤y" app:key_color="BEIGE" style="@style/HPKey" />
                        <com.hp12c.android.ui.CalculatorKeyView android:id="@+id/key_clx"  app:key_code="35" app:key_main="CLx" app:key_top="REG"   app:key_bottom="x=0" app:key_color="BEIGE" style="@style/HPKey" />
                    </LinearLayout>

                    <!-- LINHA 4 (cols 1-5): ON, f, g, STO, RCL -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">
                        <com.hp12c.android.ui.CalculatorKeyView android:id="@+id/key_on"   app:key_code="41" app:key_main="ON"  app:key_color="DARK"  style="@style/HPKey" />
                        <com.hp12c.android.ui.CalculatorKeyView android:id="@+id/key_f"    app:key_code="42" app:key_main="f"   app:key_color="ORANGE" style="@style/HPKey" />
                        <com.hp12c.android.ui.CalculatorKeyView android:id="@+id/key_g"    app:key_code="43" app:key_main="g"   app:key_color="BLUE"  style="@style/HPKey" />
                        <com.hp12c.android.ui.CalculatorKeyView android:id="@+id/key_sto"  app:key_code="44" app:key_main="STO" app:key_top="CLEAR" app:key_color="BEIGE" style="@style/HPKey" />
                        <com.hp12c.android.ui.CalculatorKeyView android:id="@+id/key_rcl"  app:key_code="45" app:key_main="RCL" app:key_top="PREFIX" app:key_color="BEIGE" style="@style/HPKey" />
                    </LinearLayout>

                </LinearLayout>

                <!-- ENTER (coluna 6) — tecla alta, span 2 linhas -->
                <com.hp12c.android.ui.CalculatorKeyView
                    android:id="@+id/key_enter"
                    app:key_code="36"
                    app:key_main="ENTER"
                    app:key_top="PREFIX"
                    app:key_bottom="LSTx"
                    app:key_color="ORANGE"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="2dp" />

                <!-- Lado direito: colunas 7-10 das linhas 3 e 4 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="4"
                    android:orientation="vertical"
                    android:layout_marginStart="1dp">

                    <!-- LINHA 3 (cols 7-10): 1, 2, 3, − -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">
                        <com.hp12c.android.ui.CalculatorKeyView android:id="@+id/key_1"   app:key_code="1"  app:key_main="1"   app:key_top="x̄r" app:key_color="BEIGE" style="@style/HPKey" />
                        <com.hp12c.android.ui.CalculatorKeyView android:id="@+id/key_2"   app:key_code="2"  app:key_main="2"   app:key_top="ŷr" app:key_color="BEIGE" style="@style/HPKey" />
                        <com.hp12c.android.ui.CalculatorKeyView android:id="@+id/key_3"   app:key_code="3"  app:key_main="3"   app:key_bottom="n!" app:key_color="BEIGE" style="@style/HPKey" />
                        <com.hp12c.android.ui.CalculatorKeyView android:id="@+id/key_sub"  app:key_code="30" app:key_main="−"   app:key_bottom="←"   app:key_color="BEIGE" style="@style/HPKey" />
                    </LinearLayout>

                    <!-- LINHA 4 (cols 7-10): 0, ., Σ+, + -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">
                        <com.hp12c.android.ui.CalculatorKeyView android:id="@+id/key_0"   app:key_code="0"  app:key_main="0"   app:key_bottom="x̄" app:key_color="BEIGE" style="@style/HPKey" />
                        <com.hp12c.android.ui.CalculatorKeyView android:id="@+id/key_dot"   app:key_code="48" app:key_main="."   app:key_bottom="s" app:key_color="BEIGE" style="@style/HPKey" />
                        <com.hp12c.android.ui.CalculatorKeyView android:id="@+id/key_sigma" app:key_code="49" app:key_main="Σ+" app:key_top="Σ-"  app:key_color="BEIGE" style="@style/HPKey" />
                        <com.hp12c.android.ui.CalculatorKeyView android:id="@+id/key_add"  app:key_code="40" app:key_main="+"   app:key_top="STO+" app:key_color="BEIGE" style="@style/HPKey" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
